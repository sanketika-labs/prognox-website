---
import Logo from '~/components/Logo.astro';
import { site } from '~/data/site';

const year = new Date().getFullYear();

const links = [
  { label: site.parent.name, href: site.parent.url },
  { label: 'LinkedIn', href: site.linkedin },
  { label: site.email, href: `mailto:${site.email}` },
];
---

<footer
  class="border-t border-[var(--color-hairline)] bg-[var(--color-surface)]"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <div
    class="container-page flex flex-col gap-6 py-9 sm:flex-row sm:items-center sm:justify-between"
  >
    <Logo />

    <div
      class="flex flex-wrap items-center gap-x-6 font-[family-name:var(--font-mono)] text-[0.6875rem] tracking-[0.14em] uppercase"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            {...(link.href.startsWith('mailto:')
              ? {}
              : { target: '_blank', rel: 'noopener noreferrer' })}
            class="inline-flex min-h-10 items-center text-[var(--color-fg-faint)] transition-colors hover:text-[var(--color-amber)]"
          >
            {link.label}
          </a>
        ))
      }
      <span class="text-[var(--color-fg-faint)] opacity-60">&copy; {year}</span>
    </div>
  </div>
</footer>
