---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="relative overflow-hidden border-b border-[var(--color-ink-700)]/60">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute top-[-16rem] left-1/2 h-[26rem] w-[min(56rem,130vw)] -translate-x-1/2 rounded-full opacity-35 blur-[100px]"
      style="background: radial-gradient(circle at 50% 50%, #5b5bd6 0%, #22d3ee44 50%, transparent 72%);"
    >
    </div>
  </div>

  <div class="container-page pt-12 pb-12 sm:pt-16 lg:pt-20 lg:pb-16">
    <div class="max-w-3xl">
      <p
        class="text-xs font-semibold tracking-[0.16em] text-[var(--color-signal-400)] uppercase sm:text-sm"
      >
        {eyebrow}
      </p>
      <h1 class="mt-3 text-[length:var(--text-h1)] leading-[1.06] font-semibold">
        {title}
      </h1>
      <p
        class="mt-5 text-[length:var(--text-lead)] leading-relaxed text-[var(--color-fg-muted)]"
      >
        {lead}
      </p>
    </div>
  </div>
</section>
