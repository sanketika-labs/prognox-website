---
import Logo from '~/components/Logo.astro';
import MobileDrawer from '~/components/nav/MobileDrawer.astro';
import { nav, site } from '~/data/site';
import { href, isActive } from '~/lib/href';

const current = Astro.url.pathname;
---

<header
  class="sticky top-0 z-30 border-b border-[var(--color-ink-700)]/70 bg-[var(--color-ink-900)]/85 backdrop-blur-lg"
  style="padding-top: env(safe-area-inset-top);"
>
  <div class="container-page flex h-16 items-center justify-between gap-4 lg:h-18">
    <a
      href={href('/')}
      class="rounded-lg transition-opacity hover:opacity-85"
      aria-label="Prognox home"
    >
      <Logo />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={href(item.path)}
            aria-current={isActive(current, href(item.path)) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3.5 py-2 text-[0.9375rem] font-medium transition-colors',
              isActive(current, href(item.path))
                ? 'text-[var(--color-signal-300)]'
                : 'text-[var(--color-fg-muted)] hover:text-[var(--color-fg)]',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={site.github}
        rel="noopener noreferrer"
        target="_blank"
        class="hidden min-h-11 items-center rounded-lg px-3.5 text-[0.9375rem] font-medium text-[var(--color-fg-muted)] transition-colors hover:text-[var(--color-fg)] lg:inline-flex"
      >
        GitHub
      </a>
      <a
        href={href('/contact')}
        class="hidden min-h-11 items-center rounded-lg bg-[var(--color-brand-500)] px-5 text-[0.9375rem] font-semibold text-white transition-colors hover:bg-[var(--color-brand-600)] lg:inline-flex"
      >
        Request a demo
      </a>

      <MobileDrawer />
    </div>
  </div>
</header>
