---
import Logo from '~/components/Logo.astro';
import ThemeToggle from '~/components/ThemeToggle.astro';
import { sections, site } from '~/data/site';
import { href } from '~/lib/href';

/**
 * A one-page site needs no menu. Three mono anchors numbered like coordinates,
 * a theme switch, and one amber call to action. Nothing collapses into a
 * hamburger because there is nothing to hide — below 640px the anchors simply
 * step aside and the CTA carries the page.
 */
---

<header
  class="sticky top-0 z-30 border-b border-[var(--color-hairline)] bg-[var(--color-surface)]/88 backdrop-blur-xl"
  style="padding-top: env(safe-area-inset-top);"
>
  <div class="container-page flex h-16 items-center justify-between gap-3">
    <a href={href('/')} class="transition-opacity hover:opacity-70" aria-label="Prognox">
      <Logo />
    </a>

    <div class="flex items-center gap-2 sm:gap-5">
      <nav class="hidden items-center gap-5 sm:flex" aria-label="Sections">
        {
          sections.map((item, i) => (
            <a
              href={`#${item.id}`}
              class="flex items-baseline gap-1.5 font-[family-name:var(--font-mono)] text-[0.6875rem] font-medium tracking-[0.18em] text-[var(--color-fg-faint)] uppercase transition-colors hover:text-[var(--color-fg)]"
            >
              <span class="text-[var(--color-amber)]">0{i + 1}</span>
              {item.label}
            </a>
          ))
        }
      </nav>

      <ThemeToggle />

      <a
        href={`mailto:${site.email}`}
        class="inline-flex min-h-10 items-center bg-[var(--color-amber)] px-4 font-[family-name:var(--font-mono)] text-[0.6875rem] font-semibold tracking-[0.14em] text-[#141a28] uppercase transition-colors hover:bg-[var(--color-amber-deep)] sm:px-5"
      >
        Get in touch
      </a>
    </div>
  </div>
</header>
