---
import { nav } from '~/data/site';
import { href, isActive } from '~/lib/href';

const current = Astro.url.pathname;
---

<div class="lg:hidden">
  <button
    type="button"
    data-drawer-open
    aria-label="Open navigation menu"
    aria-expanded="false"
    aria-controls="mobile-drawer"
    class="grid h-11 w-11 place-items-center rounded-lg text-[var(--color-fg)] transition-colors hover:bg-[var(--color-ink-700)]"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
      ></path>
    </svg>
  </button>

  <div
    data-drawer-backdrop
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 z-40 bg-black/70 opacity-0 backdrop-blur-sm transition-opacity duration-200"
  >
  </div>

  <div
    id="mobile-drawer"
    data-drawer-panel
    role="dialog"
    aria-modal="true"
    aria-label="Site navigation"
    class="fixed top-0 right-0 z-50 flex h-[100dvh] w-[min(20rem,85vw)] translate-x-full flex-col border-l border-[var(--color-ink-700)] bg-[var(--color-ink-850)] shadow-2xl transition-transform duration-200 ease-out"
    style="padding-top: env(safe-area-inset-top); padding-bottom: env(safe-area-inset-bottom);"
  >
    <div class="flex items-center justify-between border-b border-[var(--color-ink-700)] px-5 py-4">
      <span class="text-sm font-medium text-[var(--color-fg-subtle)]">Menu</span>
      <button
        type="button"
        data-drawer-close
        aria-label="Close navigation menu"
        class="grid h-11 w-11 place-items-center rounded-lg text-[var(--color-fg)] transition-colors hover:bg-[var(--color-ink-700)]"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>

    <nav class="flex flex-1 flex-col gap-1 overflow-y-auto p-4" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={href(item.path)}
            aria-current={isActive(current, href(item.path)) ? 'page' : undefined}
            class:list={[
              'flex min-h-12 items-center rounded-lg px-4 text-base font-medium transition-colors',
              isActive(current, href(item.path))
                ? 'bg-[var(--color-brand-600)]/20 text-[var(--color-signal-300)]'
                : 'text-[var(--color-fg-muted)] hover:bg-[var(--color-ink-700)] hover:text-[var(--color-fg)]',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="border-t border-[var(--color-ink-700)] p-4">
      <a
        href={href('/contact')}
        class="flex min-h-12 items-center justify-center rounded-lg bg-[var(--color-brand-500)] px-5 font-semibold text-white transition-colors hover:bg-[var(--color-brand-600)]"
      >
        Request a demo
      </a>
    </div>
  </div>
</div>

<script>
  // Vanilla rather than a framework island: a slide-over menu is not worth
  // shipping a runtime for, and this loads on every mobile page view.
  const panel = document.querySelector<HTMLElement>('[data-drawer-panel]');
  const backdrop = document.querySelector<HTMLElement>('[data-drawer-backdrop]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-drawer-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-drawer-close]');

  if (panel && backdrop && openBtn && closeBtn) {
    const focusable = () =>
      Array.from(
        panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      ).filter((el) => el.offsetParent !== null);

    const setOpen = (open: boolean) => {
      panel.classList.toggle('translate-x-full', !open);
      backdrop.classList.toggle('opacity-0', !open);
      backdrop.classList.toggle('pointer-events-none', !open);
      openBtn.setAttribute('aria-expanded', String(open));
      // Stop the page behind the drawer from scrolling under it.
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) focusable()[0]?.focus();
      else openBtn.focus();
    };

    openBtn.addEventListener('click', () => setOpen(true));
    closeBtn.addEventListener('click', () => setOpen(false));
    backdrop.addEventListener('click', () => setOpen(false));

    document.addEventListener('keydown', (e) => {
      if (openBtn.getAttribute('aria-expanded') !== 'true') return;

      if (e.key === 'Escape') {
        setOpen(false);
        return;
      }

      // Keep tabbing inside the dialog while it is open.
      if (e.key === 'Tab') {
        const items = focusable();
        const first = items[0];
        const last = items[items.length - 1];
        if (!first || !last) return;

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    // Returning via the back/forward cache must not restore a locked body.
    window.addEventListener('pageshow', () => setOpen(false));
  }
</script>
