---
/**
 * Placeholder Prognox wordmark.
 * The mark is a rising signal line — the forward-looking motif reused in
 * section dividers and the platform flow diagram.
 */
interface Props {
  /** Render the mark alone, without the wordmark text. */
  markOnly?: boolean;
  class?: string;
}

const { markOnly = false, class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    width="34"
    height="34"
    viewBox="0 0 34 34"
    fill="none"
    aria-hidden="true"
    class="shrink-0"
  >
    <defs>
      <linearGradient id="prognox-mark" x1="0" y1="34" x2="34" y2="0">
        <stop offset="0%" stop-color="#4a46c4"></stop>
        <stop offset="55%" stop-color="#5b5bd6"></stop>
        <stop offset="100%" stop-color="#22d3ee"></stop>
      </linearGradient>
    </defs>
    <rect width="34" height="34" rx="9" fill="url(#prognox-mark)"></rect>
    <path
      d="M8 22.5L13.2 16.4L17.6 19.8L26 10"
      stroke="#fff"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <circle cx="26" cy="10" r="2.9" fill="#fff"></circle>
  </svg>
  {
    !markOnly && (
      <span class="text-[1.3rem] font-semibold tracking-tight text-[var(--color-fg)]">
        Prognox
      </span>
    )
  }
</span>
