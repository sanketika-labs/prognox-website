---
import { href } from '~/lib/href';

interface Props {
  to: string;
  variant?: 'amber' | 'wire';
  /** Skip base-path resolution and open in a new tab. */
  external?: boolean;
  class?: string;
}

const { to, variant = 'amber', external = false, class: className = '' } = Astro.props;

// Squared-off and 48px tall — above the 44px minimum touch target, with a
// mono label so buttons read as part of the same system as the tags.
const base =
  'inline-flex min-h-12 items-center justify-center gap-2.5 px-6 font-[family-name:var(--font-mono)] text-[0.8125rem] font-medium tracking-[0.1em] uppercase transition-colors duration-200';

// `wire` reads its colours from the surrounding surface, so the same variant
// works on the cobalt block and on the light page without a second class.
const variants = {
  amber: 'bg-[var(--color-amber)] text-[#141a28] hover:bg-[var(--color-amber-deep)]',
  wire: 'border border-[var(--color-hairline)] text-[var(--color-fg)] hover:border-[var(--color-amber)] hover:text-[var(--color-amber)]',
} as const;

const resolved = external ? to : href(to);
const extra = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a href={resolved} class={`${base} ${variants[variant]} ${className}`} {...extra}>
  <slot />
</a>
