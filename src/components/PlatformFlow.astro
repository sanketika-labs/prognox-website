---
/**
 * Interactive pipeline walkthrough: a scrollable tab strip on a phone, a
 * four-across flow on desktop. Every panel is present in the HTML, so the
 * full content is readable and crawlable with JavaScript disabled — the
 * script only hides the inactive ones.
 */
import Icon from '~/components/Icon.astro';

type Owner = 'Obsrv' | 'UnQuery' | 'Prognox';

const stages: {
  id: string;
  step: string;
  title: string;
  owner: Owner;
  body: string;
  bullets: string[];
}[] = [
  {
    id: 'ingest',
    step: '01',
    title: 'Ingest',
    owner: 'Obsrv',
    body: 'Point Prognox at a stream, a database or a file drop. Schemas are inferred, validated and versioned without writing connector code.',
    bullets: [
      'Kafka, REST, object storage and JDBC sources',
      'Automatic schema inference with drift detection',
      'Dead-letter handling so bad records never stall a pipeline',
    ],
  },
  {
    id: 'process',
    step: '02',
    title: 'Process',
    owner: 'Obsrv',
    body: 'Real-time transformation, enrichment and denormalisation run as configuration rather than bespoke jobs — which is why setup takes hours, not quarters.',
    bullets: [
      'Sub-second stream processing at 2B+ events per day',
      'Declarative transforms, no custom Spark or Flink code',
      'Open table formats, so your data never gets locked in',
    ],
  },
  {
    id: 'ask',
    step: '03',
    title: 'Ask',
    owner: 'UnQuery',
    body: 'Ask in plain English. UnQuery resolves the question against your metadata and generates a query that runs in your own environment — the data never leaves.',
    bullets: [
      'Druid, ClickHouse, Pinot, Iceberg, Hudi, Delta Lake, DuckDB',
      'Metadata-only architecture; execution stays inside your perimeter',
      'Embeddable agents, and it works alongside Superset and Metabase',
    ],
  },
  {
    id: 'forecast',
    step: '04',
    title: 'Forecast',
    owner: 'Prognox',
    body: 'The layer that makes it Prognox. Once history is modelled and questions are answerable, the same pipeline projects forward and flags anomalies before they land.',
    bullets: [
      'Trend and seasonality modelling on live series',
      'Anomaly detection against learned baselines',
      'Forecasts exposed through the same natural-language interface',
    ],
  },
];

const ownerStyle: Record<Owner, string> = {
  Obsrv: 'bg-[var(--color-brand-500)]/18 text-[var(--color-brand-200)]',
  UnQuery: 'bg-[var(--color-signal-500)]/18 text-[var(--color-signal-300)]',
  Prognox: 'bg-[var(--color-amber-400)]/18 text-[var(--color-amber-400)]',
};
---

<div data-flow>
  <div
    role="tablist"
    aria-label="Platform stages"
    class="-mx-[clamp(1.25rem,4vw,3rem)] flex snap-x snap-mandatory gap-3 overflow-x-auto px-[clamp(1.25rem,4vw,3rem)] pb-2 lg:mx-0 lg:grid lg:grid-cols-4 lg:px-0 lg:pb-0"
  >
    {
      stages.map((stage, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${stage.id}`}
          data-flow-tab={stage.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`panel-${stage.id}`}
          class:list={[
            'min-h-[88px] w-[13rem] shrink-0 snap-start rounded-xl border p-4 text-left transition-colors lg:w-auto',
            'aria-selected:border-[var(--color-brand-500)] aria-selected:bg-[var(--color-brand-500)]/12',
            'border-[var(--color-ink-700)] bg-[var(--color-ink-800)]/60 hover:border-[var(--color-ink-600)]',
          ]}
        >
          <span class="text-xs font-semibold tracking-widest text-[var(--color-fg-subtle)]">
            {stage.step}
          </span>
          <span class="mt-1.5 block text-lg font-semibold text-[var(--color-fg)]">
            {stage.title}
          </span>
          <span
            class:list={[
              'mt-2 inline-block rounded-full px-2 py-0.5 text-[0.6875rem] font-semibold',
              ownerStyle[stage.owner],
            ]}
          >
            {stage.owner}
          </span>
        </button>
      ))
    }
  </div>

  <div class="mt-5 space-y-5">
    {
      stages.map((stage, i) => (
        <div
          id={`panel-${stage.id}`}
          data-flow-panel={stage.id}
          role="tabpanel"
          aria-labelledby={`tab-${stage.id}`}
          class:list={['surface-card p-6 lg:p-9', i !== 0 && 'js-hidden']}
        >
          <h3 class="text-[length:var(--text-h3)] font-semibold">
            {stage.step} &middot; {stage.title}
          </h3>
          <p class="mt-3 max-w-2xl leading-relaxed text-[var(--color-fg-muted)]">{stage.body}</p>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:gap-4" role="list">
            {stage.bullets.map((bullet) => (
              <li class="flex gap-3 text-[0.9375rem] leading-relaxed">
                <span class="mt-0.5 shrink-0 text-[var(--color-signal-400)]">
                  <Icon name="check" size={19} />
                </span>
                <span class="text-[var(--color-fg-muted)]">{bullet}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-flow]');

  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-flow-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-flow-panel]'));

    // Only collapse the panels once the script runs. Without JS all four stay
    // visible and the page still reads correctly.
    root.dataset.enhanced = 'true';

    const select = (id: string) => {
      tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.flowTab === id)));
      panels.forEach((panel) => panel.classList.toggle('js-hidden', panel.dataset.flowPanel !== id));
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab.dataset.flowTab!));

      // Arrow keys move between tabs, as expected of a tablist.
      tab.addEventListener('keydown', (e) => {
        const delta = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!delta) return;
        e.preventDefault();
        const next = tabs[(index + delta + tabs.length) % tabs.length]!;
        next.focus();
        select(next.dataset.flowTab!);
      });
    });
  }
</script>

<style>
  /* Applied only after the script marks the component as enhanced, so a
     no-JS visitor sees every panel rather than a single stage. */
  [data-flow][data-enhanced='true'] .js-hidden {
    display: none;
  }
</style>
