---
import Button from '~/components/Button.astro';
import { site } from '~/data/site';
---

<section class="relative overflow-hidden">
  <!-- Ambient gradient wash. Decorative only, hidden from assistive tech. -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute top-[-18rem] left-1/2 h-[34rem] w-[min(68rem,140vw)] -translate-x-1/2 rounded-full opacity-45 blur-[110px]"
      style="background: radial-gradient(circle at 50% 50%, #5b5bd6 0%, #22d3ee55 45%, transparent 70%);"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.07]"
      style="background-image: linear-gradient(to right, #fff 1px, transparent 1px), linear-gradient(to bottom, #fff 1px, transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(ellipse at 50% 0%, #000 30%, transparent 72%);"
    >
    </div>
  </div>

  <div class="container-page pt-14 pb-16 sm:pt-20 lg:pt-28 lg:pb-24">
    <div class="mx-auto max-w-4xl text-center">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-[var(--color-ink-600)] bg-[var(--color-ink-800)]/70 px-3.5 py-1.5 text-xs font-medium text-[var(--color-fg-muted)] sm:text-sm"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-signal-400)]"></span>
        Obsrv and UnQuery, now one platform
      </p>

      <h1 class="mt-6 text-[length:var(--text-display)] leading-[1.04] font-semibold">
        <span class="text-gradient">Predictive intelligence</span>
        <span class="block">on your data</span>
      </h1>

      <p
        class="mx-auto mt-6 max-w-2xl text-[length:var(--text-lead)] leading-relaxed text-[var(--color-fg-muted)]"
      >
        Prognox turns raw streams into decisions. Real-time pipelines that stand up in hours, plain-English
        questions answered precisely, and the forecasting layer that tells you what happens next.
      </p>

      <div class="mt-9 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-center">
        <Button to="/contact">Request a demo</Button>
        <Button to={site.github} variant="secondary" external>
          Start with open source
        </Button>
      </div>

      <p class="mt-5 text-sm text-[var(--color-fg-subtle)]">
        Apache 2.0 core &middot; Deploy on AWS, GCP, Azure or on-premises
      </p>
    </div>
  </div>
</section>
