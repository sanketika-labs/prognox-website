---
import Icon from '~/components/Icon.astro';
import type { Feature } from '~/lib/types';

interface Props {
  features: Feature[];
  columns?: 2 | 3;
}

const { features, columns = 3 } = Astro.props;
---

<ul
  class:list={[
    'grid gap-5 sm:grid-cols-2',
    columns === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-2',
  ]}
  role="list"
>
  {
    features.map((feature) => (
      <li class="surface-card flex flex-col p-6 transition-colors hover:border-[var(--color-brand-500)]/60 lg:p-7">
        <span class="mb-5 grid h-11 w-11 place-items-center rounded-xl bg-[var(--color-brand-500)]/15 text-[var(--color-signal-400)]">
          <Icon name={feature.icon} />
        </span>
        <h3 class="text-[length:var(--text-h3)] font-semibold">{feature.title}</h3>
        <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-[var(--color-fg-muted)]">
          {feature.body}
        </p>
      </li>
    ))
  }
</ul>
