---
import Button from '~/components/Button.astro';
import { site } from '~/data/site';

interface Props {
  title?: string;
  body?: string;
}

const {
  title = 'See Prognox on your data',
  body = 'A working pipeline and your first natural-language answers, usually inside a day. Bring a dataset and we will show you.',
} = Astro.props;
---

<section class="section-y">
  <div class="container-page">
    <div
      class="surface-card relative overflow-hidden px-6 py-12 text-center sm:px-10 lg:px-16 lg:py-16"
    >
      <div
        class="pointer-events-none absolute inset-0 -z-10 opacity-60"
        aria-hidden="true"
        style="background: radial-gradient(ellipse at 50% 0%, #5b5bd640 0%, transparent 65%);"
      >
      </div>

      <h2 class="mx-auto max-w-2xl text-[length:var(--text-h2)] leading-tight font-semibold">
        {title}
      </h2>
      <p
        class="mx-auto mt-4 max-w-xl text-[length:var(--text-lead)] leading-relaxed text-[var(--color-fg-muted)]"
      >
        {body}
      </p>

      <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-center">
        <Button to="/contact">Request a demo</Button>
        <Button to={site.docs} variant="secondary" external>Read the docs</Button>
      </div>
    </div>
  </div>
</section>
