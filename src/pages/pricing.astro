---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import CTASection from '~/components/CTASection.astro';
import Button from '~/components/Button.astro';
import Icon from '~/components/Icon.astro';
import { site } from '~/data/site';

const tiers = [
  {
    name: 'Open source',
    price: 'Free',
    note: 'Apache 2.0, forever',
    body: 'The data engineering core, self-hosted. No licence cost, no usage ceiling, no seat counting.',
    features: [
      'Full ingestion and real-time processing',
      'Deploy on AWS, GCP, Azure or on-premises',
      'Open table formats, no data lock-in',
      'Community support',
    ],
    cta: { label: 'Get it on GitHub', to: site.github, external: true },
    featured: false,
  },
  {
    name: 'Prognox Pro',
    price: 'Custom',
    note: 'Priced to your volume',
    body: 'The full platform — engineering, natural-language querying and forecasting — operated with support behind it.',
    features: [
      'Everything in open source',
      'Natural-language querying across your engines',
      'Forecasting and anomaly detection',
      '24/7 support with response SLAs',
      'Custom integrations built with you',
      'Dedicated account management',
    ],
    cta: { label: 'Request a demo', to: '/contact', external: false },
    featured: true,
  },
];

const faqs = [
  {
    q: 'Is the open source version crippled?',
    a: 'No. The Apache 2.0 core is the same data engineering engine running in production at national scale. Pro adds the querying and forecasting layers, plus support and operations.',
  },
  {
    q: 'Does my data leave my environment?',
    a: 'No. The querying layer holds metadata — schema and semantics — and generates queries that execute inside your own infrastructure. Your rows stay where they are.',
  },
  {
    q: 'What does Pro cost?',
    a: 'It depends on volume and deployment shape, so we quote rather than publish. For reference, one EdTech enterprise runs its full workload at roughly $10K a year after an 80% cost reduction.',
  },
  {
    q: 'Can we start open source and move to Pro later?',
    a: 'Yes, and most teams do. The core is the same, so moving to Pro adds capability without a migration.',
  },
];
---

<BaseLayout
  title="Pricing"
  description="Prognox pricing: a free Apache 2.0 open source core you can self-host, and Prognox Pro priced to your volume with support and the full intelligence layer."
>
  <PageHeader
    eyebrow="Pricing"
    title="Free to start. Priced to your volume."
    lead="The data engineering core is open source and always will be. You pay when you want the intelligence layer, the support, and someone else operating it."
  />

  <section class="section-y">
    <div class="container-page">
      <div class="mx-auto grid max-w-5xl gap-5 lg:grid-cols-2 lg:gap-6">
        {
          tiers.map((tier) => (
            <article
              class:list={[
                'surface-card flex flex-col p-7 lg:p-9',
                tier.featured && 'border-[var(--color-brand-500)]/60',
              ]}
            >
              {tier.featured && (
                <span class="mb-4 inline-flex w-fit rounded-full bg-[var(--color-brand-500)]/18 px-3 py-1 text-xs font-semibold text-[var(--color-brand-200)]">
                  Full platform
                </span>
              )}
              <h2 class="text-[length:var(--text-h3)] font-semibold">{tier.name}</h2>
              <p class="mt-4 text-[clamp(2rem,1.5rem+2vw,2.75rem)] leading-none font-semibold">
                {tier.price}
              </p>
              <p class="mt-2 text-sm font-medium text-[var(--color-signal-400)]">{tier.note}</p>
              <p class="mt-5 leading-relaxed text-[var(--color-fg-muted)]">{tier.body}</p>

              <ul class="mt-7 flex-1 space-y-3" role="list">
                {tier.features.map((feature) => (
                  <li class="flex items-start gap-3 text-[0.9375rem]">
                    <span class="mt-0.5 shrink-0 text-[var(--color-signal-400)]">
                      <Icon name="check" size={19} />
                    </span>
                    <span class="text-[var(--color-fg-muted)]">{feature}</span>
                  </li>
                ))}
              </ul>

              <Button
                to={tier.cta.to}
                external={tier.cta.external}
                variant={tier.featured ? 'primary' : 'secondary'}
                class="mt-8 w-full"
              >
                {tier.cta.label}
              </Button>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-y bg-[var(--color-ink-950)]/40">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-[length:var(--text-h2)] font-semibold">Questions worth asking first</h2>
        <dl class="mt-9 space-y-6">
          {
            faqs.map((faq) => (
              <div class="border-b border-[var(--color-ink-700)] pb-6 last:border-0">
                <dt class="text-[length:var(--text-h3)] font-semibold">{faq.q}</dt>
                <dd class="mt-2.5 leading-relaxed text-[var(--color-fg-muted)]">{faq.a}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <CTASection
    title="Get a number for your workload"
    body="Describe your volume and sources, and we will come back with a real figure rather than a range."
  />
</BaseLayout>
