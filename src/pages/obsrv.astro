---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import SectionHeading from '~/components/SectionHeading.astro';
import FeatureGrid from '~/components/FeatureGrid.astro';
import type { Feature } from '~/lib/types';
import CTASection from '~/components/CTASection.astro';
import Button from '~/components/Button.astro';
import Icon from '~/components/Icon.astro';
import { site } from '~/data/site';

const features: Feature[] = [
  {
    icon: 'unlock',
    title: 'Zero lock-in',
    body: 'Open standards and a portable architecture. Deploy anywhere, and take your data with you if you leave.',
  },
  {
    icon: 'bolt',
    title: 'Real time',
    body: 'Instant streaming and processing, so insight arrives while it still changes a decision.',
  },
  {
    icon: 'plug',
    title: 'Plug and play',
    body: 'Integrations connect without a complex setup phase or a bespoke connector per source.',
  },
  {
    icon: 'automate',
    title: 'Power of automation',
    body: 'Repetitive pipeline work is automated away, leaving your engineers on problems that are actually yours.',
  },
  {
    icon: 'clock',
    title: 'Quick, simple setup',
    body: 'Querying begins within hours of first connection, with minimal configuration.',
  },
  {
    icon: 'scale',
    title: 'Tested for scale',
    body: 'Battle-tested on national infrastructure handling volumes most platforms only model.',
  },
];

const proof = [
  {
    value: '2B+',
    label: 'Events per day at peak',
  },
  {
    value: '500M+',
    label: 'Daily events on DIKSHA',
  },
  {
    value: '100%',
    label: 'Uptime over 2+ years',
  },
];
---

<BaseLayout
  title="Obsrv"
  description="Obsrv is the data engineering core of Prognox: real-time ingestion and processing at any scale, with zero lock-in and setup measured in hours."
>
  <PageHeader
    eyebrow="Obsrv · Data engineering"
    title="Data. Engineered."
    lead="Get data to speak your language, with out-of-the-box data engineering and no custom code. Obsrv is the half of Prognox that makes your data trustworthy, current and ready to query."
  />

  <section class="section-y">
    <div class="container-page">
      <div class="grid gap-3 sm:grid-cols-3 sm:gap-5">
        {
          proof.map((item) => (
            <div class="surface-card p-6 text-center">
              <span class="block text-[clamp(1.75rem,1.2rem+2.5vw,2.75rem)] leading-none font-semibold text-[var(--color-amber-400)]">
                {item.value}
              </span>
              <span class="mt-2.5 block text-[0.9375rem] text-[var(--color-fg-muted)]">
                {item.label}
              </span>
            </div>
          ))
        }
      </div>
      <p class="mt-5 text-sm text-[var(--color-fg-subtle)]">
        Figures from Obsrv running in production, including DIKSHA, India's national education
        platform.
      </p>
    </div>
  </section>

  <section class="section-y bg-[var(--color-ink-950)]/40">
    <div class="container-page">
      <SectionHeading
        eyebrow="Why Obsrv"
        title="Six things you stop building yourself"
        lead="Each of these is a project a data team would otherwise own, staff and maintain."
      />
      <div class="mt-12 lg:mt-14">
        <FeatureGrid features={features} />
      </div>
    </div>
  </section>

  <section class="section-y">
    <div class="container-page">
      <SectionHeading
        eyebrow="Deployment"
        title="Start free, scale when it matters"
      />

      <div class="mx-auto mt-12 grid max-w-4xl gap-5 lg:grid-cols-2">
        <article class="surface-card flex flex-col p-7 lg:p-8">
          <h3 class="text-[length:var(--text-h3)] font-semibold">Sunbird Obsrv</h3>
          <p class="mt-1 text-sm font-medium text-[var(--color-signal-400)]">
            Free and open source, Apache 2.0
          </p>
          <p class="mt-4 flex-1 leading-relaxed text-[var(--color-fg-muted)]">
            The full data engineering core, self-hosted on AWS, GCP, Azure or your own hardware.
            Community supported, no licence cost, no usage ceiling.
          </p>
          <Button to={site.github} variant="secondary" external class="mt-7 w-full">
            Get it on GitHub
          </Button>
        </article>

        <article
          class="surface-card flex flex-col border-[var(--color-brand-500)]/50 p-7 lg:p-8"
        >
          <h3 class="text-[length:var(--text-h3)] font-semibold">Obsrv Pro</h3>
          <p class="mt-1 text-sm font-medium text-[var(--color-signal-400)]">
            Enterprise SaaS
          </p>
          <p class="mt-4 leading-relaxed text-[var(--color-fg-muted)]">
            Everything in the open source core, operated for you.
          </p>
          <ul class="mt-5 flex-1 space-y-2.5" role="list">
            {
              [
                '24/7 support with response SLAs',
                'Custom integrations built with you',
                'Dedicated account management',
              ].map((item) => (
                <li class="flex items-start gap-3 text-[0.9375rem]">
                  <span class="mt-0.5 shrink-0 text-[var(--color-signal-400)]">
                    <Icon name="check" size={19} />
                  </span>
                  <span class="text-[var(--color-fg-muted)]">{item}</span>
                </li>
              ))
            }
          </ul>
          <Button to="/contact" class="mt-7 w-full">Talk to us</Button>
        </article>
      </div>
    </div>
  </section>

  <CTASection
    title="Put Obsrv on your streams"
    body="Bring a live source and we will show you ingestion, processing and a first query against it."
  />
</BaseLayout>
