---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import CTASection from '~/components/CTASection.astro';

const entries = (await getCollection('usecases')).sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  entries.map(async (entry) => ({
    data: entry.data,
    Content: (await render(entry)).Content,
  })),
);
---

<BaseLayout
  title="Use Cases"
  description="Where Prognox runs today: national education infrastructure, climate advisory systems, EdTech platforms and high-frequency sensor fleets."
>
  <PageHeader
    eyebrow="Use cases"
    title="Deployed where the numbers are real"
    lead="Each of these is a production deployment of the Obsrv core, several with UnQuery on top. The figures are measured, not modelled."
  />

  <section class="section-y">
    <div class="container-page">
      <div class="space-y-5 lg:space-y-6">
        {
          rendered.map(({ data, Content }) => (
            <article class="surface-card overflow-hidden">
              <div class="grid gap-0 lg:grid-cols-[1fr_17rem]">
                <div class="p-7 lg:p-10">
                  <p class="text-xs font-semibold tracking-[0.16em] text-[var(--color-signal-400)] uppercase sm:text-sm">
                    {data.sector}
                  </p>
                  <h2 class="mt-3 text-[length:var(--text-h3)] leading-snug font-semibold sm:text-[length:var(--text-h2)] sm:leading-tight">
                    {data.title}
                  </h2>
                  <p class="mt-4 text-[length:var(--text-lead)] leading-relaxed text-[var(--color-fg-muted)]">
                    {data.summary}
                  </p>
                  <div class="mt-5 space-y-4 leading-relaxed text-[var(--color-fg-muted)] [&>p]:text-[0.9375rem]">
                    <Content />
                  </div>
                </div>

                {/* Metrics rail: a side column on desktop, a footer strip on mobile. */}
                <div class="flex gap-4 border-t border-[var(--color-ink-700)] bg-[var(--color-ink-950)]/50 p-7 sm:gap-8 lg:flex-col lg:justify-center lg:gap-8 lg:border-t-0 lg:border-l lg:p-8">
                  {data.metrics.map((metric) => (
                    <div>
                      <span class="block text-[clamp(1.5rem,1.1rem+1.8vw,2.25rem)] leading-none font-semibold text-[var(--color-amber-400)]">
                        {metric.value}
                      </span>
                      <span class="mt-2 block text-sm leading-snug text-[var(--color-fg-subtle)]">
                        {metric.label}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    title="Is yours the next one?"
    body="Tell us what you are trying to measure and we will tell you honestly whether Prognox is the right fit for it."
  />
</BaseLayout>
