---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
---

<BaseLayout title="Page not found" description="That page does not exist on the Prognox site.">
  <section class="container-page flex min-h-[calc(100dvh-9rem)] flex-col justify-center py-20">
    <p class="tag"><span class="tag-mark"></span>Error 404</p>
    <p
      class="mt-8 font-[family-name:var(--font-display)] text-[clamp(5rem,3rem+12vw,12rem)] leading-none font-bold tracking-[-0.06em] outline-text"
    >
      404
    </p>
    <h1 class="mt-6 max-w-[18ch] text-[length:var(--text-h2)] leading-[1.05] font-bold">
      Nothing lives at this address.
    </h1>
    <p class="mt-6 max-w-md text-[length:var(--text-lead)] leading-relaxed text-[var(--color-fg-muted)]">
      Prognox is a single page — whatever you were after is almost certainly on it.
    </p>
    <div class="mt-10">
      <Button to="/" variant="amber">Back to the start</Button>
    </div>
  </section>
</BaseLayout>
